{
  "name": "lookup_lecture_venue",
  "description": "Look up the lecture venue and time slots for a CoCIS course from the approved timetable. Use when a student asks where or when a lecture takes place. Returns an empty list if the course is not in the timetable; never guess a venue.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "course_code"
    ],
    "properties": {
      "course_code": {
        "type": "string",
        "pattern": "^[A-Z]{3}\\d{4}$",
        "description": "Course code in capitals, e.g. BSE4104"
      },
      "day": {
        "type": "string",
        "enum": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri"
        ],
        "description": "Optional weekday filter"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "count",
      "matches",
      "source"
    ],
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 0
      },
      "source": {
        "type": "string"
      },
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "course_code",
            "course_name",
            "day",
            "start",
            "end",
            "venue"
          ],
          "properties": {
            "course_code": {
              "type": "string"
            },
            "course_name": {
              "type": "string"
            },
            "day": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "venue": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}