{
  "name": "submit_support_request",
  "description": "Submit an existing DRAFT support request so that it is sent to CoCIS support staff. HIGHER IMPACT: requires explicit human approval before it runs.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_ref"
    ],
    "properties": {
      "case_ref": {
        "type": "string",
        "pattern": "^CC-\\d{4}-\\d{5}$",
        "description": "Support request reference, e.g. CC-2026-00001"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_ref",
      "category",
      "summary",
      "status",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "case_ref": {
        "type": "string",
        "pattern": "^CC-\\d{4}-\\d{5}$",
        "description": "Support request reference, e.g. CC-2026-00001"
      },
      "category": {
        "type": "string",
        "enum": [
          "registration",
          "fees",
          "timetable",
          "accounts",
          "other"
        ]
      },
      "summary": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SUBMITTED"
        ]
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      }
    }
  }
}